# How to use the GPU on the CCB cluster from a conda environment 

# Use the rapids tool to identify compatible packages
# https://docs.rapids.ai/install/
# I selected cuda 12.2-12.9, python 3.11, and pytorch
# this created a conda command as follows: 
# "conda create -n rapids-26.02 -c rapidsai -c conda-forge \
#    rapids=26.02 python=3.11 'cuda-version>=12.2,<=12.9' \
#    'pytorch=*=*cuda*'"

# Another option is to use this information to modify a conda .yaml file to include these specific versions
# I didn't actually need the rapidsai functionality 

# Before running the conda create command I started an interactive run on the gpu node. This means that conda will look for the gpu versions of packages. 
$ srun --partition=gpu --gpus 1 --cpus-per-task 5 --mem 16G -t 01:00:00 --pty bash -l

# Create the environment on the gpu node
$ conda create -f my_env.yaml

# Activate the environment
$ conda activate my_env

# Check if the gpus can be accessed
# Launch python and look for the cuda
$ python
> import torch
> torch.cuda.is_available()
True
> exit()

